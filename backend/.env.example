# Local development:
# 1. Copy this file to backend/.env
# 2. Start Django/Celery with DJANGO_LOAD_DOTENV=true
# 3. Never commit backend/.env
#
# Example:
#   DJANGO_LOAD_DOTENV=true backend/venv/bin/python backend/manage.py runserver
#
# Django Settings
DJANGO_SETTINGS_MODULE=TradeSimulator.settings
SECRET_KEY=your-secret-key-generate-a-strong-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Database (Railway will provide this in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/privateiv

# Local development database fallback when DATABASE_URL is not set
DB_NAME=privateiv
DB_USER=your-local-postgres-user
DB_PASSWORD=your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Redis/Celery (Railway will provide this)
CELERY_BROKER_URL=redis://localhost:6379/0
# Celery task results use django-db, configured in TradeSimulator/settings.py.

# API Keys (get from providers)
BVL_API_KEY=your-bvl-api-key
FMP_API=your-fmp-api-key

# Datadog (optional)
DD_API_KEY=your-datadog-api-key
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=bolsasim-api
DD_VERSION=1.0.0

# Frontend origins (set the Vercel domain in Railway for deployment)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
FRONTEND_URL=http://localhost:5173
